@ReleaseScope.Api_HostAddress = http://localhost:5080

GET {{ReleaseScope.Api_HostAddress}}/health
Accept: application/json

###

GET {{ReleaseScope.Api_HostAddress}}/api/dashboard
Accept: application/json

###

POST {{ReleaseScope.Api_HostAddress}}/api/assessments
Content-Type: application/json

{
  "changedFiles": 38,
  "linesChanged": 2400,
  "failedTests": 1,
  "testCoveragePercent": 72,
  "recentIncidentRate": 0.12,
  "criticalComponents": 2,
  "performanceRegressionPercent": 4,
  "securityFindings": 0,
  "hasRollbackPlan": true
}

###

# GitHub webhook requests must be signed from the exact raw body.
# Follow docs/WEBHOOKS.md to generate the X-Hub-Signature-256 value.
POST {{ReleaseScope.Api_HostAddress}}/api/webhooks/github
Content-Type: application/json
X-GitHub-Event: deployment
X-GitHub-Delivery: local-example-001
X-Hub-Signature-256: sha256=replace-with-generated-signature

{
  "repository": { "full_name": "portfolio/releasescope" },
  "sender": { "login": "local-developer" },
  "deployment": {
    "environment": "staging",
    "ref": "main",
    "sha": "0123456789abcdef0123456789abcdef01234567"
  }
}

###

GET {{ReleaseScope.Api_HostAddress}}/api/webhooks/events
Accept: application/json
